# Copy this file to backend/.env and fill in ONE LLM option.

# --- Database (the read-only role created by db/03_readonly_role.sh) ---
DATABASE_URL=postgresql://nl2sql_reader:reader_pw@localhost:5432/bankdb

# --- LLM option A: OpenAI ---
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-...

# --- LLM option B: Azure OpenAI / Microsoft Foundry (use your deployment name) ---
# LLM_MODEL=azure/gpt-4.1-mini
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/
# AZURE_API_VERSION=2024-10-21

# --- LLM option C: Google Gemini (has a free tier) ---
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=...

# --- LLM option D: Ollama, free and local (pull the model first: ollama pull qwen2.5-coder:7b) ---
# LLM_MODEL=ollama/qwen2.5-coder:7b

# For reasoning models such as gpt-5-mini, keep reasoning short to save cost and time:
# LLM_REASONING_EFFORT=low

# --- API ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20

# --- Public demo protection (set these when hosting publicly) ---
# PER_IP_DAILY_LIMIT=20        # questions per visitor per day
# DAILY_QUESTION_LIMIT=300     # questions for everyone combined per day
# TRUST_PROXY_HEADERS=true     # needed behind Render/Vercel to see the real visitor IP
